# Restaurant "menu" surface. When set (e.g. "delivered.menu"), each restaurant is
# reachable at BOTH <slug>.delivered.menu and delivered.menu/<slug> (→ /sites/<slug>);
# unclaimed drafts render watermarked+noindex, published sites go live+indexable.
# Leave BLANK to keep the feature dormant (routing + outreach links stay off).
# Requires the apex + www + a *.<domain> wildcard record pointed at this Vercel project.
NEXT_PUBLIC_MENU_BASE_DOMAIN=

# Claim verification (docs/CLAIM_VERIFICATION_PLAN.md). When '1'/'true', claiming an
# auto-built restaurant site requires an OTP to the phone on its public listing before
# ownership transfers. Needs the Twilio vars below + the claim_verifications migration.
CLAIM_VERIFICATION_ENABLED=
# Twilio SMS (also used by claim verification). Set either TWILIO_MESSAGING_SERVICE_SID
# (preferred) or TWILIO_FROM. TWILIO_AUTH_TOKEN already powers the inbound webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# X (Twitter) OAuth 2.0
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...
TWITTER_CALLBACK_URL=https://delivered.menu/api/social/x/callback

PROFILE_IMAGES_BUCKET=...
NEXT_PUBLIC_LOCAL_URL=http://localhost:3000

NEXT_PUBLIC_CALENDLY_URL=

STRIPE_SECRET_KEY=sk_live_or_test
STRIPE_WEBHOOK_SECRET=whsec_...

QS_PUBLIC_URL=https://www.quicksites.ai   # https://www.quicksites.ai or http://localhost:3000 in dev
QS_BILLING_STRIPE_WEBHOOK_SECRET=whsec_...    # webhook secret for your *platform billing* endpoint
STRIPE_PRICE_PRO_MONTHLY=price_1234567890abc        # Quicksites Pro price ID (legacy single-price)

# --- Agency plan (Path B) — per-user platform price + per-site price ---
# Create ONE published price set (Public: $19/user/mo + $6/site/mo). Founders get
# the discount via coupon(s), not separate prices.
STRIPE_PRICE_AGENCY_PLATFORM=price_...   # recurring, $19/user/mo
STRIPE_PRICE_AGENCY_PERSITE=price_...     # recurring, $6/site/mo (billed by quantity)
# Founder grandfather: comma-separated Stripe coupon IDs applied at checkout for
# tier=founder. Recommended: two product-restricted percent_off coupons
# (platform 21.05% -> $15, per-site 16.67% -> $5) with duration=repeating,
# duration_in_months=12, so it auto-rolls to Public pricing after a year.
STRIPE_COUPON_AGENCY_FOUNDER=coupon_platform,coupon_persite
# Flip to 'true' to expose self-serve agency checkout on /pricing (Path B CTA).
NEXT_PUBLIC_AGENCY_BILLING_ENABLED=false

INVITE_FROM="QuickSites <noreply@quicksites.ai>"

