NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://kcwruliugwidsdgsrthy.supabase.co

# --- Supabase API keys ---
# Prefer the NEW key system (Dashboard → Settings → API Keys):
#   • Publishable key (sb_publishable_…) → put it in NEXT_PUBLIC_SUPABASE_ANON_KEY
#     (browser-safe by design; build-time inlined, so the var name stays as-is).
#   • Secret key (sb_secret_…)           → put it in SUPABASE_SECRET_KEY.
#     instrumentation.ts maps SUPABASE_SECRET_KEY → SUPABASE_SERVICE_ROLE_KEY at boot,
#     so you don't have to touch the 200+ files that read the legacy name.
# The secret key can be rolled independently in the dashboard WITHOUT dropping user
# sessions or invalidating the publishable key — unlike rotating the legacy JWT secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...        # (legacy: anon JWT also works)
SUPABASE_SECRETlo_KEY=sb_secret_...                       # preferred new server key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here    # legacy fallback (still honored)
SUPABASE_ANON_KEY=optional-public-key
EMAIL_USER=your.email@example.com
EMAIL_PASS=your_gmail_app_password
INTERNAL_DEPLOY_TOKEN=your-secret-token
VERCEL_DEPLOY_WEBHOOK=https://api.vercel.com/v1/integrations/deploy/...
ALLOW_ORIGIN=https://yourdomain.com
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_BASE_URL=https://quicksites.ai
OPENAI_API_KEY=your-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DEBUG_AUTH=true
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_key
NAMECHEAP_API_USER=yournamecheapusername
NAMECHEAP_API_KEY=yournamecheapapikey
NAMECHEAP_CLIENT_IP=your.whitelisted.ip
NAMECHEAP_SANDBOX=true

# "Businesses near me" geographic lead-gen fan-out (/admin/prospects).
# Google Places API (NEW) — must be enabled in GCP for this key (searchNearby).
GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Location-industry domain campaigns (boston-towing.com). Registration SPENDS MONEY —
# off unless set to 1; needs the NAMECHEAP_* creds above + registrant contact below.
GEO_DOMAIN_REGISTER_ENABLED=0
NAMECHEAP_REGISTRANT_FIRST=
NAMECHEAP_REGISTRANT_LAST=
NAMECHEAP_REGISTRANT_ADDRESS=
NAMECHEAP_REGISTRANT_CITY=
NAMECHEAP_REGISTRANT_STATE=
NAMECHEAP_REGISTRANT_ZIP=
NAMECHEAP_REGISTRANT_COUNTRY=US
NAMECHEAP_REGISTRANT_PHONE=
NAMECHEAP_REGISTRANT_EMAIL=
# Competition outreach — postcards (Lob) + SMS (Twilio). Both SPEND MONEY / carry
# compliance duties, so both are off unless their *_ENABLED flag is set.
LOB_API_KEY=
POSTCARD_MAIL_ENABLED=0
LOB_FROM_NAME=
LOB_FROM_LINE1=
LOB_FROM_CITY=
LOB_FROM_STATE=
LOB_FROM_ZIP=
# Required by Lob on US postcards: 'marketing' (default) or 'operational'.
LOB_USE_TYPE=marketing
# Signs inbound Lob delivery webhooks (Dashboard → Webhooks) → /api/outreach/webhooks/lob.
# Without it the webhook fails closed in production (delivery tracking won't update).
LOB_WEBHOOK_SECRET=
# Cold B2B SMS needs A2P 10DLC registration + opt-out handling before enabling.
PROSPECT_SMS_ENABLED=0
# Geo-domain call tracking (Twilio). Buying numbers costs money → off unless =1.
# Uses TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN (above). Fallback = where calls forward
# when a campaign has no business number yet.
CALL_TRACKING_ENABLED=0
CALL_TRACKING_FALLBACK_NUMBER=
# Geo-domain rental subscriptions (Stripe). Uses STRIPE_SECRET_KEY (above). Point a
# Stripe webhook at /api/stripe/geo-webhook (checkout.session.completed +
# customer.subscription.updated/deleted) and set its signing secret here.
STRIPE_GEO_WEBHOOK_SECRET=
WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/path
VERCEL_TOKEN=
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
NEXT_PUBLIC_GSC_ENABLED=true

# Subscriptions QuickSites
STRIPE_SECRET_KEY=sk_test_...
STRIPE_MONTHLY_SITE_PRICE_ID=price_...

# Merchant e-Commerce
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SUPABASE_URL=...
