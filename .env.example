REVIEWS_IMPORT_DEBUG=1
# --- Analytics: PostHog ---
# Client (browser) — safe to expose. Get from PostHog project settings.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side capture (money path, cron). Defaults to the NEXT_PUBLIC_* values if unset.
POSTHOG_KEY=phc_your_project_key
POSTHOG_HOST=https://us.i.posthog.com

# --- LLM usage metering ---
# Hard ceilings for AI spend; enforced by lib/ai cost guard (see docs/LLM_METERING.md).
LLM_METERING_ENABLED=true
LLM_DAILY_USD_LIMIT=50
LLM_MONTHLY_USD_LIMIT=1000
# Optional per-user/day cap (cents) to throttle abuse on AI generation endpoints.
LLM_PER_USER_DAILY_CENTS=200
# NOTE: the dollar budget guard reads ai_usage_events.occurred_at — it was
# previously querying a non-existent `created_at` (silently inert); fixed in
# lib/ai/meter.ts. Make sure LLM_METERING_ENABLED=true for the caps above to bite.

# --- AI cost-abuse alerting (cron: /api/cron/ai-cost-alert, every 15 min) ---
# Emails ADMIN_EMAILS + raises a Sentry warning when rolling spend crosses a
# threshold (with an anon/guest breakdown). 0 disables that window.
AI_ALERT_HOURLY_USD=5           # alert if AI spend in the last hour ≥ this
AI_ALERT_DAILY_USD=40          # alert if AI spend in the last 24h ≥ this
AI_ALERT_COOLDOWN_MINUTES=60   # min minutes between alert emails

# --- Guest build (unauthenticated draft sites) ---
# Lets logged-out visitors build a DRAFT site (Supabase anonymous session); it is
# never published to the homepage and requires sign-up to publish/claim.
# PREREQUISITE: enable "Allow anonymous sign-ins" in the Supabase dashboard first.
NEXT_PUBLIC_GUEST_BUILD_ENABLED=1   # '1'/'true' to enable; empty/0 to keep off
GUEST_AI_CALL_LIMIT=8               # AI generations per guest session before sign-up
GUEST_DRAFT_HOURLY_LIMIT_PER_IP=10  # max guest draft sites created per IP per hour (0 = off)

# --- Automated demo-site generation (AI; see lib/builder/generateDemoSite.ts) ---
# The admin "Generate demos" button works regardless; these only gate the CRON.
DEMO_AUTOGEN_ENABLED=false      # 'true' lets the daily cron mint demo sites (spends on OpenAI)
DEMO_AUTOGEN_PER_RUN=1          # demos minted per cron run (max 5)
# Public storage bucket for generated hero images (defaults to 'templates').
SUPABASE_STORAGE_BUCKET=templates

# --- Commerce test mode (scaffold) ---
# When '1', /api/commerce/checkout skips Stripe and marks the order paid (test),
# so the order -> platform_fee -> commission_ledger flow can be proven without
# Stripe keys / a connected account. Leave unset/0 once real Stripe is configured.
QS_TEST_CHECKOUT=0
# Platform fee % applied for merchants without a configured payment_account (test only).
QS_TEST_PLATFORM_FEE_PERCENT=0.05
# Base URL for checkout success/cancel redirects.
QS_PUBLIC_URL=http://localhost:3000

# --- Stripe Connect (real money path) ---
# Default platform fee % applied to a merchant's payment_account at onboarding.
QS_DEFAULT_PLATFORM_FEE_PERCENT=0.05
# (STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET already defined above are required for
#  real Connect onboarding + checkout. APP_BASE_URL is used for onboarding return URLs.)

# --- Partner / reseller economics (see /partners + lib/commerce/partner-terms.ts) ---
QS_MAX_PLATFORM_FEE_PERCENT=0.10   # partner can set the order fee up to 10%
QS_PARTNER_FEE_SHARE=0.80          # partner keeps 80% of each fee; QuickSites keeps 20%
QS_RESIDUAL_MONTHS=0               # 0 = lifetime residual
QS_REFUND_WINDOW_DAYS=14            # days a commission stays pending before payout-eligible

# --- Print-on-demand (Author sites: Lulu books + Gelato posters/apparel) ---
# Off until POD_ENABLED=true AND a provider is configured. See docs/POD_AUTHOR_PLAN.md.
POD_ENABLED=false
POD_PLATFORM_MARGIN_PERCENT=0.30   # margin added on top of the provider's print cost
# Lulu (books). Default API base is the free sandbox; switch to https://api.lulu.com for prod.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CONTACT_EMAIL=support@quicksites.ai
LULU_WEBHOOK_SECRET=
# Gelato (posters/apparel).
GELATO_API_KEY=
# Countries Stripe collects a shipping address for on POD/physical carts (ISO-2, CSV).
QS_SHIP_COUNTRIES=US,CA,GB,AU,IE,NZ
# Enable Stripe Tax on physical/POD checkouts (requires Stripe Tax set up on the
# account). When on, Stripe computes tax at checkout; markOrderPaid records it to
# orders.tax_cents and reconciles orders.total_cents. Tax is never part of the
# platform-fee basis (we take a cut of margin, not tax).
QS_STRIPE_TAX_ENABLED=false

# Geo recommendations: LLM "top 3 this week" synthesis (grounded in the deterministic
# rules). Off by default; needs OPENAI_API_KEY. Metered via lib/ai/meter.
# NOTE: this synthesis now only runs for PREMIUM (rented) campaigns.
GEO_RECS_LLM_ENABLED=0

# AI SEO Coaching (premium): daily "next best step" + weekly summary emails for
# paid-plan site owners. Master gate for the two crons (seo-coach-daily/-weekly);
# both no-op unless this is set. Emails queue into email_outbox → email-drain sends.
AI_SEO_COACH_ENABLED=0
# Grounded LLM polish for the coaching copy. Off → deterministic rule text is used.
# Needs OPENAI_API_KEY; metered + budget-guarded via lib/ai/meter.
AI_SEO_COACH_LLM_ENABLED=0
