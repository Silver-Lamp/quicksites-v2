{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/admin/*": ["admin/*"],
      "@/app/*": ["app/*"],
      "@/components/*": ["components/*"],
      "@/constants/*": ["constants/*"],
      "@/context/*": ["context/*"],
      "@/hooks/*": ["hooks/*"],
      "@/lib/*": ["lib/*"],
      "@/scripts/*": ["scripts/*"],
      // ⚠️ `test` and `tests` are two different real directories. `tests/` is Playwright; `test/`
      // holds the Jest setup, the module stubs and shared test helpers. Only `tests` was mapped, so
      // `@/test/...` resolved under Jest (its moduleNameMapper has a blanket `^@/(.*)$`) and failed
      // under `tsc` — green tests, red typecheck, from the same import.
      "@/test/*": ["test/*"],
      "@/tests/*": ["tests/*"],
      "@/types/*": ["types/*"],
      "@/ui/*": ["ui/*"]
      /* ⚠️ intentionally no "@/*": ["./*"] */
    }
  }
}
