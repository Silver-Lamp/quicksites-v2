{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2021", "DOM"],
    "jsx": "preserve",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "outDir": ".lint-tmp",
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["next", "next/image-types/global", "node"],
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "isolatedModules": true
    /* no baseUrl/paths here; inherited from tsconfig.base.json */
  },
  "include": [
    ".next/types",
    ".next/types/**/*.ts",
    "admin",
    "app",
    "components",
    "hooks",
    "lib",
    "types",
    "pages",
    "scripts",
    "next-env.d.ts",
    "api",
    "_pages-legacy"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
